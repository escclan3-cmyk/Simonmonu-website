<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-Jn1ddiIoUfW5i+AeZOw9ttj1F5ocKY3yMycQwKrRNAQ=' 'sha256-mbXkg+Y1HxEeBgGGvZG1gNWcDqMernNICvNAWlRy/+A='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; media-src 'self'; form-action 'none'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
