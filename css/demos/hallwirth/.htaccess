<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-pyQ5z1mH7oUrxY7LWvbnHzvITHF/+y5SGXFk6SLIsAM='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; media-src 'self'; form-action 'none'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
ErrorDocument 404 /demos/hallwirth/404.html
